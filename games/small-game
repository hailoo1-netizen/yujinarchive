<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>소수의 나눗셈 보드게임</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#E7F4FA; --panel:#FFFFFF; --ink:#22385E; --muted:#5A6B88; --line:#D3E2EC;
  --accent:#EE6424; --accent-ink:#FFFFFF; --good:#23905A; --bad:#D23F35; --field:#F2F8FB;
  --shadow:0 6px 0 rgba(34,56,94,.12);
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#122030; --panel:#1B2C3D; --ink:#EAF2F9; --muted:#A3B5C8; --line:#2D4357;
    --accent:#FF8448; --accent-ink:#1B1208; --good:#5ECB8E; --bad:#FF7C72; --field:#233749;
    --shadow:0 6px 0 rgba(0,0,0,.35);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#122030; --panel:#1B2C3D; --ink:#EAF2F9; --muted:#A3B5C8; --line:#2D4357;
  --accent:#FF8448; --accent-ink:#1B1208; --good:#5ECB8E; --bad:#FF7C72; --field:#233749;
  --shadow:0 6px 0 rgba(0,0,0,.35);
  color-scheme:dark;
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
body{
  margin:0; background:var(--bg); color:var(--ink);
  font-family:'Jua','Apple SD Gothic Neo','Malgun Gothic','Noto Sans KR',system-ui,sans-serif;
  font-size:17px; line-height:1.5;
}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

.wrap{max-width:1320px;margin:0 auto;padding:16px;display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:start}
@media (max-width:900px){.wrap{grid-template-columns:1fr;padding:10px}}

.board-box{background:#9BCB4A;border-radius:22px;overflow:hidden;box-shadow:var(--shadow)}
.board-box svg{display:block;width:100%;height:auto}

.title{font-size:28px;line-height:1.2;margin:0 0 4px}
.sub{margin:0;color:var(--muted);font-size:15px}

.panel{display:flex;flex-direction:column;gap:12px}
.card{background:var(--panel);border-radius:18px;padding:16px;box-shadow:var(--shadow)}

.turn{display:flex;align-items:center;gap:10px;font-size:21px}
.dot{width:22px;height:22px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 2px rgba(0,0,0,.15);flex:none}
.dice-row{display:flex;align-items:center;gap:14px;margin-top:12px}
.die{width:72px;height:72px;border-radius:16px;background:var(--field);border:3px solid var(--line);display:grid;place-items:center;font-size:40px;flex:none}
.btn{border:0;border-radius:14px;padding:12px 18px;font-size:19px;background:var(--accent);color:var(--accent-ink);box-shadow:0 4px 0 rgba(0,0,0,.18)}
.btn:active{transform:translateY(2px);box-shadow:0 2px 0 rgba(0,0,0,.18)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.ghost{background:var(--field);color:var(--ink);border:2px solid var(--line);box-shadow:none}
.btn.wide{width:100%}

.players{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.players li{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:10px}
.players li.now{background:var(--field)}
.players .where{margin-left:auto;color:var(--muted);font-size:15px}
.players .rest{font-size:13px;color:var(--bad);margin-left:4px}

.log{list-style:none;margin:0;padding:0;font-size:15px;color:var(--muted);display:grid;gap:4px;max-height:170px;overflow:auto}
.log li:first-child{color:var(--ink)}
h2{font-size:18px;margin:0 0 8px;font-weight:normal}
.rules{margin:0;padding-left:20px;font-size:15px;color:var(--muted)}

/* overlays */
.overlay{position:fixed;inset:0;background:rgba(10,25,40,.55);display:flex;align-items:center;justify-content:center;padding:16px;z-index:20;
  padding-top:calc(16px + env(safe-area-inset-top,0px));padding-bottom:calc(16px + env(safe-area-inset-bottom,0px))}
.sheet{background:var(--panel);border-radius:22px;padding:22px;width:min(460px,100%);max-height:100%;overflow:auto;box-shadow:0 10px 0 rgba(0,0,0,.2)}
.who{display:flex;align-items:center;gap:8px;margin:0 0 6px;color:var(--muted)}
.prob{font-size:clamp(30px,8vw,44px);line-height:1.2;margin:4px 0 2px}
.eq{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:24px;margin:14px 0 4px}
.eq label{display:flex;flex-direction:column;align-items:center;font-size:14px;color:var(--muted);gap:2px}
.eq input{width:110px;font-size:26px;text-align:center;padding:6px 8px;border-radius:12px;border:3px solid var(--line);background:var(--field)}
.eq input:focus{border-color:var(--accent);outline:none}
.tip{margin:0;color:var(--muted);font-size:15px}
.msg{min-height:1.5em;margin:6px 0;color:var(--bad);font-size:15px}
.result{border-radius:14px;padding:12px 14px;margin:6px 0 12px;font-size:17px}
.result.ok{background:color-mix(in srgb,var(--good) 16%,transparent);color:var(--ink)}
.result.no{background:color-mix(in srgb,var(--bad) 14%,transparent);color:var(--ink)}
.result b{font-weight:normal;font-size:20px;display:block;margin-bottom:2px}
.result.ok b{color:var(--good)} .result.no b{color:var(--bad)}
.check{font-size:16px;color:var(--muted)}

.seg{display:flex;gap:8px;margin:6px 0 14px}
.seg button{flex:1;padding:10px;border-radius:12px;border:3px solid var(--line);background:var(--field);font-size:18px}
.seg button[aria-pressed="true"]{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 15%,var(--field))}
.stepper{display:flex;align-items:center;gap:12px;margin:6px 0 16px}
.stepper button{width:52px;height:52px;border-radius:14px;border:3px solid var(--line);background:var(--field);font-size:26px;line-height:1}
.stepper button:disabled{opacity:.4;cursor:not-allowed}
.stepper span{flex:1;text-align:center;font-size:26px}
.names{display:grid;gap:8px;margin-bottom:16px}
.names label{display:flex;align-items:center;gap:10px}
.names input{flex:1;padding:8px 10px;border-radius:10px;border:2px solid var(--line);background:var(--field);font-size:17px}
.win-big{font-size:46px;text-align:center;margin:0}

/* svg */
.tile-rect{stroke:#fff;stroke-width:4}
.tile.hit .tile-rect{stroke:#EE6424;stroke-width:6}
.tok{transition:transform .25s ease}
@media (prefers-reduced-motion:reduce){.tok{transition:none}}
</style>
</head>
<body>

<div class="wrap">
  <main>
    <div class="board-box"><svg id="board" role="img" aria-label="소수의 나눗셈 보드게임 판"></svg></div>
  </main>

  <aside class="panel">
    <div class="card">
      <h1 class="title">소수의 나눗셈 놀이</h1>
      <p class="sub">몫은 자연수까지, 나머지도 구해요</p>
    </div>

    <div class="card">
      <div class="turn"><span class="dot" id="turnDot"></span><span id="turnName">준비 중</span></div>
      <div class="dice-row">
        <div class="die" id="die" aria-live="polite">🎲</div>
        <button class="btn" id="rollBtn">주사위 굴리기</button>
      </div>
    </div>

    <div class="card">
      <h2>말 위치</h2>
      <ul class="players" id="playerList"></ul>
    </div>

    <div class="card">
      <h2>진행 기록</h2>
      <ul class="log" id="log"></ul>
    </div>

    <div class="card">
      <h2>규칙</h2>
      <ol class="rules">
        <li>주사위를 굴려 나온 수만큼 말을 움직여요.</li>
        <li>도착한 칸의 나눗셈을 몫은 자연수까지 구하고 나머지를 적어요.</li>
        <li>맞히면 그 자리에 머물고, 틀리면 원래 칸으로 돌아가요.</li>
        <li>2칸 뛰기 칸에서는 두 칸 더 가고, 한 번 쉬기 칸에서는 다음 차례를 쉬어요.</li>
        <li>먼저 도착 칸에 닿는 사람이 이겨요.</li>
      </ol>
      <button class="btn ghost wide" id="restartBtn" style="margin-top:12px">새 게임 시작</button>
    </div>
  </aside>
</div>

<!-- 시작 설정 -->
<div class="overlay" id="setup">
  <div class="sheet">
    <h1 class="title">소수의 나눗셈 놀이</h1>
    <p class="sub" style="margin-bottom:14px">몇 명이 함께 하나요?</p>
    <div class="seg" id="countSeg">
      <button data-n="2" aria-pressed="true">2명</button>
      <button data-n="3" aria-pressed="false">3명</button>
      <button data-n="4" aria-pressed="false">4명</button>
    </div>
    <p class="sub" style="margin-bottom:4px">플레이어 이름을 적어 주세요 (비워 두면 1모둠, 2모둠으로 정해져요)</p>
    <div class="names" id="nameInputs"></div>
    <p class="sub" style="margin-bottom:4px">주사위 눈 (1부터 몇까지 나올지 정해요)</p>
    <div class="stepper">
      <button type="button" id="diceMinus" aria-label="주사위 눈 줄이기">−</button>
      <span id="diceLabel" aria-live="polite">1 ~ 6</span>
      <button type="button" id="dicePlus" aria-label="주사위 눈 늘리기">+</button>
    </div>
    <button class="btn wide" id="startBtn">게임 시작</button>
  </div>
</div>

<!-- 문제 -->
<div class="overlay" id="qModal" hidden>
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="qProb">
    <p class="who"><span class="dot" id="qDot"></span><span id="qWho"></span></p>
    <div class="prob" id="qProb"></div>
    <p class="tip">몫은 자연수까지 구하고, 나머지를 적어요. 나머지가 없으면 0을 적어요.</p>
    <div class="eq">
      <label>몫<input id="inQ" inputmode="numeric" autocomplete="off"></label>
      <span aria-hidden="true">…</span>
      <label>나머지<input id="inR" inputmode="decimal" autocomplete="off"></label>
    </div>
    <p class="msg" id="qMsg" role="alert"></p>
    <div class="result" id="qResult" hidden></div>
    <button class="btn wide" id="qSubmit">정답 확인</button>
    <button class="btn wide" id="qNext" hidden>다음 차례</button>
  </div>
</div>

<!-- 우승 -->
<div class="overlay" id="winModal" hidden>
  <div class="sheet" style="text-align:center">
    <p class="win-big">🏆</p>
    <h1 class="title" id="winText"></h1>
    <p class="sub" style="margin-bottom:16px">도착 칸에 가장 먼저 닿았어요!</p>
    <button class="btn wide" id="againBtn">다시 하기</button>
  </div>
</div>

<script>
/* ---------- 판 데이터 (사진 속 순서 그대로) ---------- */
const TILES = [
  {t:'start'},
  {a:'61',b:'2.44'},{a:'63',b:'4.5'},{a:'1.75',b:'0.5'},{a:'4.37',b:'2.3'},{a:'6.3',b:'0.7'},
  {a:'13.5',b:'2.5'},{a:'8.75',b:'0.25'},{a:'3.6',b:'0.2'},{a:'22.4',b:'1.6'},{a:'5.25',b:'1.75'},
  {a:'16.8',b:'4.2'},{a:'7.35',b:'1.05'},{a:'9.6',b:'0.8'},{a:'4.8',b:'0.08'},{a:'8.4',b:'0.15'},
  {a:'1.6',b:'0.32'},{a:'10.8',b:'0.36'},
  {t:'jump'},
  {a:'8.28',b:'2.3'},{a:'7.25',b:'2.9'},{a:'22.75',b:'2.5'},{a:'3.12',b:'1.2'},{a:'4',b:'0.8'},
  {a:'6',b:'0.25'},{a:'36',b:'2.25'},
  {t:'rest'},
  {a:'14',b:'0.5'},
  {t:'end'}
];
const LAST = TILES.length - 1;
const COLORS = ['#E5413A','#2C78E4','#F0B400','#8C46D6'];
const DEFAULT_NAMES = ['1모둠','2모둠','3모둠','4모둠'];

/* ---------- 정확한 소수 계산 (정수로 바꿔서) ---------- */
const S = 10000;
function toInt(s){
  s = String(s).trim();
  if(!/^\d*\.?\d*$/.test(s) || s === '' || s === '.') return null;
  const [i, f=''] = s.split('.');
  if(f.length > 4) return null;
  return Number(i || 0) * S + Number((f + '0000').slice(0,4));
}
function fmt(n){
  const ip = Math.floor(n / S), fp = String(n % S).padStart(4,'0').replace(/0+$/,'');
  return fp ? ip + '.' + fp : String(ip);
}
function solve(tile){
  const A = toInt(tile.a), B = toInt(tile.b);
  const q = Math.floor(A / B), r = A - B * q;
  return {q, r};
}

/* ---------- 상태 ---------- */
let players = [], cur = 0, busy = false, diceMax = 6, playerCount = 2;
let pending = null; // {player, startPos}

/* ---------- SVG 판 그리기 ---------- */
const svg = document.getElementById('board');
const NS = 'http://www.w3.org/2000/svg';
function el(tag, attrs, parent){
  const e = document.createElementNS(NS, tag);
  for(const k in attrs) e.setAttribute(k, attrs[k]);
  if(parent) parent.appendChild(e);
  return e;
}
let centers = [], cfg = null, tileEls = [], tokenEls = [], layoutKey = '';

function waypoints(c){
  const pts = [];
  for(let r=0;r<c.R;r++){
    const y = c.y0 - r*c.gap, ltr = r%2===0;
    const a = ltr ? c.xL : c.xR, b = ltr ? c.xR : c.xL;
    const w = (r%2 ? 1 : -1) * 12;
    pts.push([a,y],[(a*2+b)/3,y+w],[(a+b*2)/3,y-w],[b,y]);
    if(r < c.R-1) pts.push([ltr ? c.tr : c.tl, y - c.gap/2]);
  }
  return pts;
}
function smoothPath(p){
  let d = `M${p[0][0]},${p[0][1]}`;
  for(let i=0;i<p.length-1;i++){
    const p0 = p[i-1] || p[i], p1 = p[i], p2 = p[i+1], p3 = p[i+2] || p2;
    const c1 = [p1[0]+(p2[0]-p0[0])/6, p1[1]+(p2[1]-p0[1])/6];
    const c2 = [p2[0]-(p3[0]-p1[0])/6, p2[1]-(p3[1]-p1[1])/6];
    d += ` C${c1[0]},${c1[1]} ${c2[0]},${c2[1]} ${p2[0]},${p2[1]}`;
  }
  return d;
}

function buildBoard(){
  const portrait = window.innerWidth < 720;
  const key = portrait ? 'p' : 'l';
  if(key === layoutKey) return;
  layoutKey = key;
  cfg = portrait
    ? {W:600,H:1060,R:7,xL:105,xR:495,y0:985,gap:134,tl:60,tr:540,tw:106,th:58,fs:18}
    : {W:1000,H:640,R:4,xL:125,xR:875,y0:565,gap:138,tl:62,tr:938,tw:106,th:58,fs:18};
  const {W,H} = cfg;
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  svg.innerHTML = '';

  // 하늘과 들판
  const defs = el('defs',{},svg);
  const g1 = el('linearGradient',{id:'sky',x1:0,y1:0,x2:0,y2:1},defs);
  el('stop',{offset:'0',  'stop-color':'#7FCBEF'},g1);
  el('stop',{offset:'1',  'stop-color':'#CDEEFA'},g1);
  el('rect',{x:0,y:0,width:W,height:H,fill:'url(#sky)'},svg);
  const top = cfg.y0 - (cfg.R-1)*cfg.gap - 70;
  el('path',{d:`M0,${top+20} C${W*.25},${top-30} ${W*.45},${top+30} ${W*.7},${top} S${W},${top-10} ${W},${top+10} L${W},${H} L0,${H} Z`,fill:'#9BCB4A'},svg);
  el('circle',{cx:W-70,cy:48,r:28,fill:'#FFE36B'},svg);
  [[90,42],[W*.45,30]].forEach(([x,y])=>{
    el('ellipse',{cx:x,cy:y,rx:40,ry:14,fill:'#fff',opacity:.9},svg);
    el('ellipse',{cx:x+22,cy:y-8,rx:22,ry:12,fill:'#fff',opacity:.9},svg);
  });

  // 장식
  const deco = ['🍁','🌳','🌼','🍂','🌸','🍄','🌲','🌷'];
  let k = 0;
  for(let r=0;r<cfg.R-1;r++){
    const y = cfg.y0 - r*cfg.gap - cfg.gap/2 + 9;
    [.3,.52,.74].forEach(f=>{
      const t = el('text',{x:W*f + (r%2?20:-20),y,'font-size':24,'text-anchor':'middle',opacity:.9},svg);
      t.textContent = deco[k++ % deco.length];
    });
  }

  // 길
  const d = smoothPath(waypoints(cfg));
  el('path',{d,fill:'none',stroke:'#FFFFFF','stroke-width':cfg.th+22,'stroke-linecap':'round','stroke-linejoin':'round'},svg);
  const road = el('path',{d,fill:'none',stroke:'#FFF4CF','stroke-width':cfg.th+10,'stroke-linecap':'round','stroke-linejoin':'round'},svg);

  // 칸 위치
  const L = road.getTotalLength();
  centers = TILES.map((_,i)=>{ const p = road.getPointAtLength(L*i/LAST); return [p.x,p.y]; });

  // 칸
  tileEls = [];
  const tg = el('g',{},svg);
  TILES.forEach((tile,i)=>{
    const [x,y] = centers[i];
    const g = el('g',{class:'tile'},tg);
    let fill, color, lines;
    if(tile.t==='start'){ fill='#EE6424'; color='#fff'; lines=['출발']; }
    else if(tile.t==='end'){ fill='#EE6424'; color='#fff'; lines=['도착']; }
    else if(tile.t==='jump'){ fill='#EE6424'; color='#fff'; lines=['2칸','뛰기']; }
    else if(tile.t==='rest'){ fill='#EE6424'; color='#fff'; lines=['한 번','쉬기']; }
    else { const y2 = i%2===1; fill = y2 ? '#FFE27A' : '#8FD0F2'; color = y2 ? '#B9470F' : '#173C78'; lines=[`${tile.a}÷${tile.b}`]; }
    el('rect',{class:'tile-rect',x:x-cfg.tw/2,y:y-cfg.th/2,width:cfg.tw,height:cfg.th,rx:14,fill},g);
    const big = tile.t==='start' || tile.t==='end';
    lines.forEach((s,j)=>{
      const fs = big ? cfg.fs+6 : (lines.length>1 ? cfg.fs-1 : cfg.fs);
      const off = lines.length>1 ? (j===0 ? -fs*.45 : fs*.65) : fs*.35;
      const t = el('text',{x, y:y+off, 'font-size':fs, 'text-anchor':'middle', fill:color, 'font-family':"Jua, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif"},g);
      t.textContent = s;
    });
    tileEls.push(g);
  });

  // 말
  tokenEls = [];
  const kg = el('g',{},svg);
  players.forEach((p,i)=>{
    const g = el('g',{class:'tok'},kg);
    el('circle',{cx:0,cy:0,r:15,fill:p.color,stroke:'#fff','stroke-width':4},g);
    const t = el('text',{x:0,y:6,'font-size':16,'text-anchor':'middle',fill:'#fff','font-family':'Jua, sans-serif'},g);
    t.textContent = i+1;
    tokenEls.push(g);
  });
  placeTokens();
}

const OFFS = [[-30,-24],[30,-24],[-30,24],[30,24]];
function placeTokens(){
  players.forEach((p,i)=>{
    const [x,y] = centers[p.pos];
    const [ox,oy] = OFFS[i];
    if(tokenEls[i]) tokenEls[i].style.transform = `translate(${x+ox}px,${y+oy}px)`;
  });
}
function highlight(i){
  tileEls.forEach((g,j)=>g.classList.toggle('hit', j===i));
}

/* ---------- 화면 갱신 ---------- */
function tileName(i){
  const t = TILES[i];
  if(t.t==='start') return '출발';
  if(t.t==='end') return '도착';
  if(t.t==='jump') return '2칸 뛰기';
  if(t.t==='rest') return '한 번 쉬기';
  return `${t.a}÷${t.b}`;
}
function renderPanel(){
  const p = players[cur];
  document.getElementById('turnDot').style.background = p ? p.color : '#ccc';
  document.getElementById('turnName').textContent = p ? `${p.name} 차례` : '준비 중';
  const ul = document.getElementById('playerList');
  ul.innerHTML = '';
  players.forEach((pl,i)=>{
    const li = document.createElement('li');
    if(i===cur) li.className = 'now';
    li.innerHTML = `<span class="dot" style="background:${pl.color}"></span><span></span><span class="where"></span>`;
    li.children[1].textContent = pl.name;
    if(pl.skip){ const s = document.createElement('span'); s.className='rest'; s.textContent='쉬는 중'; li.children[1].appendChild(s); }
    li.children[2].textContent = `${pl.pos}번째 칸 · ${tileName(pl.pos)}`;
    ul.appendChild(li);
  });
  document.getElementById('rollBtn').disabled = busy;
}
function log(msg){
  const li = document.createElement('li');
  li.textContent = msg;
  const ul = document.getElementById('log');
  ul.prepend(li);
  while(ul.children.length > 30) ul.lastChild.remove();
}
const sleep = ms => new Promise(r=>setTimeout(r, matchMedia('(prefers-reduced-motion: reduce)').matches ? Math.min(ms,60) : ms));

/* ---------- 진행 ---------- */
async function moveTo(p, target){
  const step = target > p.pos ? 1 : -1;
  while(p.pos !== target){
    p.pos += step;
    placeTokens();
    await sleep(260);
  }
  renderPanel();
}

async function roll(){
  if(busy) return;
  busy = true; renderPanel();
  const die = document.getElementById('die');
  let n = 1;
  for(let i=0;i<9;i++){ n = 1 + Math.floor(Math.random()*diceMax); die.textContent = n; await sleep(70); }
  const p = players[cur];
  log(`${p.name}: 주사위 ${n}`);
  const start = p.pos;
  await moveTo(p, Math.min(p.pos + n, LAST));
  landed(p, start);
}

async function landed(p, start){
  const t = TILES[p.pos];
  highlight(p.pos);
  if(t.t==='end'){ win(p); return; }
  if(t.t==='jump'){
    log(`${p.name}: 2칸 뛰기!`);
    await sleep(350);
    await moveTo(p, Math.min(p.pos + 2, LAST));
    landed(p, start);
    return;
  }
  if(t.t==='rest'){
    p.skip = true;
    log(`${p.name}: 한 번 쉬기 칸이라 다음 차례를 쉬어요`);
    nextTurn();
    return;
  }
  openQuestion(p, start);
}

function nextTurn(){
  highlight(-1);
  for(let i=0;i<players.length;i++){
    cur = (cur + 1) % players.length;
    if(players[cur].skip){
      players[cur].skip = false;
      log(`${players[cur].name}: 이번 차례는 쉬어요`);
      continue;
    }
    break;
  }
  busy = false;
  renderPanel();
}

/* ---------- 문제 창 ---------- */
const qModal = document.getElementById('qModal');
const inQ = document.getElementById('inQ'), inR = document.getElementById('inR');
const qMsg = document.getElementById('qMsg'), qResult = document.getElementById('qResult');
const qSubmit = document.getElementById('qSubmit'), qNext = document.getElementById('qNext');

function openQuestion(p, start){
  const t = TILES[p.pos];
  pending = {player:p, start, correct:false};
  document.getElementById('qDot').style.background = p.color;
  document.getElementById('qWho').textContent = `${p.name}의 문제`;
  document.getElementById('qProb').textContent = `${t.a} ÷ ${t.b}`;
  inQ.value = ''; inR.value = ''; inQ.disabled = false; inR.disabled = false;
  qMsg.textContent = ''; qResult.hidden = true;
  qSubmit.hidden = false; qNext.hidden = true;
  qModal.hidden = false;
  setTimeout(()=>inQ.focus(), 50);
}

function check(){
  const qs = inQ.value.trim(), rs = inR.value.trim();
  if(qs==='' || rs===''){ qMsg.textContent = '몫과 나머지를 모두 적어 주세요. 나머지가 없으면 0을 적어요.'; return; }
  if(!/^\d+$/.test(qs)){ qMsg.textContent = '몫은 자연수로 적어요. 소수점 없이 적어 주세요.'; inQ.focus(); return; }
  const rv = toInt(rs);
  if(rv === null){ qMsg.textContent = '나머지는 0.25처럼 숫자로 적어 주세요.'; inR.focus(); return; }
  qMsg.textContent = '';

  const p = pending.player, t = TILES[p.pos];
  const {q, r} = solve(t);
  const ok = Number(qs) === q && rv === r;
  pending.correct = ok;
  const checkLine = `확인: ${t.b} × ${q} + ${fmt(r)} = ${t.a}`;
  qResult.className = 'result ' + (ok ? 'ok' : 'no');
  if(ok){
    qResult.innerHTML = `<b>정답이에요!</b><span class="check"></span>`;
    qNext.textContent = '다음 차례';
    log(`${p.name}: ${t.a}÷${t.b} 정답 (몫 ${q}, 나머지 ${fmt(r)})`);
  } else {
    qResult.innerHTML = `<b>아쉬워요</b>정답은 몫 ${q}, 나머지 ${fmt(r)}이에요.<br><span class="check"></span>`;
    qNext.textContent = pending.start === p.pos ? '다음 차례' : '원래 칸으로 돌아가기';
    log(`${p.name}: ${t.a}÷${t.b} 오답, 원래 칸으로`);
  }
  qResult.querySelector('.check').textContent = checkLine;
  qResult.hidden = false;
  inQ.disabled = true; inR.disabled = true;
  qSubmit.hidden = true; qNext.hidden = false;
  qNext.focus();
}

async function closeQuestion(){
  qModal.hidden = true;
  const {player, start, correct} = pending;
  pending = null;
  if(!correct && player.pos !== start){
    await sleep(150);
    await moveTo(player, start);
  }
  nextTurn();
}

qSubmit.addEventListener('click', check);
qNext.addEventListener('click', closeQuestion);
inQ.addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); inR.focus(); } });
inR.addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); check(); } });

/* ---------- 우승 ---------- */
function win(p){
  log(`${p.name} 도착!`);
  document.getElementById('winText').textContent = `${p.name} 우승!`;
  document.getElementById('winModal').hidden = false;
}
document.getElementById('againBtn').addEventListener('click', ()=>{
  document.getElementById('winModal').hidden = true;
  openSetup();
});

/* ---------- 시작 설정 ---------- */
const setup = document.getElementById('setup');
function renderNameInputs(){
  const box = document.getElementById('nameInputs');
  const old = [...box.querySelectorAll('input')].map(i=>i.value);
  box.innerHTML = '';
  for(let i=0;i<playerCount;i++){
    const lab = document.createElement('label');
    lab.innerHTML = `<span class="dot" style="background:${COLORS[i]}"></span><input maxlength="10">`;
    const inp = lab.querySelector('input');
    inp.value = old[i] || '';
    inp.placeholder = `${i+1}번 플레이어 이름`;
    inp.setAttribute('aria-label', `${i+1}번 플레이어 이름`);
    inp.addEventListener('keydown', e=>{
      if(e.key !== 'Enter') return;
      e.preventDefault();
      const next = box.querySelectorAll('input')[i+1];
      if(next) next.focus(); else document.getElementById('startBtn').click();
    });
    box.appendChild(lab);
  }
}
function segment(id, attr, onPick){
  const seg = document.getElementById(id);
  seg.addEventListener('click', e=>{
    const b = e.target.closest('button'); if(!b) return;
    seg.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed', x===b ? 'true' : 'false'));
    onPick(Number(b.dataset[attr]));
  });
}
segment('countSeg','n', n=>{ playerCount = n; renderNameInputs(); });
const DICE_MIN = 1, DICE_MAX = 10;
function renderDice(){
  document.getElementById('diceLabel').textContent = diceMax === 1 ? '항상 1' : `1 ~ ${diceMax}`;
  document.getElementById('diceMinus').disabled = diceMax <= DICE_MIN;
  document.getElementById('dicePlus').disabled = diceMax >= DICE_MAX;
}
document.getElementById('diceMinus').addEventListener('click', ()=>{ if(diceMax > DICE_MIN){ diceMax--; renderDice(); } });
document.getElementById('dicePlus').addEventListener('click', ()=>{ if(diceMax < DICE_MAX){ diceMax++; renderDice(); } });
renderDice();

function openSetup(){
  setup.hidden = false;
  renderNameInputs();
  const first = document.querySelector('#nameInputs input');
  if(first) setTimeout(()=>first.focus(), 50);
}
document.getElementById('startBtn').addEventListener('click', ()=>{
  const names = [...document.querySelectorAll('#nameInputs input')].map((i,k)=>i.value.trim() || DEFAULT_NAMES[k]);
  players = names.map((name,i)=>({name, color:COLORS[i], pos:0, skip:false}));
  cur = 0; busy = false;
  document.getElementById('log').innerHTML = '';
  document.getElementById('die').textContent = '🎲';
  layoutKey = ''; buildBoard(); highlight(-1);
  log(`게임 시작! 주사위 1~${diceMax}`);
  setup.hidden = true;
  renderPanel();
  document.getElementById('rollBtn').focus();
});
document.getElementById('restartBtn').addEventListener('click', ()=>{
  if(players.length && !confirm('지금 게임을 끝내고 새로 시작할까요?')) return;
  qModal.hidden = true;
  openSetup();
});
document.getElementById('rollBtn').addEventListener('click', roll);

window.addEventListener('resize', ()=>{ buildBoard(); });

/* 처음 화면 */
buildBoard();
renderPanel();
openSetup();
</script>
</body>
